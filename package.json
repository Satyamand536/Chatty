{
  "name": "chaos-kitchen",
  "private": true,
  "version": "0.1.0",
  "description": "CHAOS KITCHEN \u2014 co-op kitchen party game. Phase 1: headless deterministic simulation.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json",
    "build:assets": "tsx packages/assets/build.ts",
    "bench:sim": "tsx packages/sim/bench.ts",
    "dev": "npm run dev --workspace @chaos-kitchen/client",
    "build:client": "vite build --config packages/client/vite.config.ts",
    "serve": "npm run build:client && node packages/client/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "tsx": "^4.23.0"
  }
}